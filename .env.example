# Copy this file to backend/.env and fill in real values. Never commit the real .env file.

GEMINI_API_KEY=your-ai-studio-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
FIREBASE_PROJECT_ID=your-project-id

# Optional: illustrations on the Visual aids page (free Cloudflare Workers AI account).
# Without these, visual aids still return the labelled diagram and explanation.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
# Optional backup when Cloudflare's daily allowance runs out: a secret key from https://enter.pollinations.ai
POLLINATIONS_API_KEY=your-pollinations-secret-key
